// Publication sur Cloudflare Workers (Workers Builds relié au dépôt GitHub) : site statique servi
// depuis dist/, plus un petit script (worker/index.js, NEXORA #026) limité aux adresses
// /__supabase-api/* : relais de l'API de gestion de Supabase pour le back office.
// Sans ce fichier, `wrangler deploy` configure le projet tout seul comme une app Vite
// standard (plugin Cloudflare pour Vite) et produit `assets` sans `directory` : échec du déploiement.
// NEXORA est assemblé par scripts/build-web.mjs (interface dans dist/, back office dans dist/admin/).
{
  // Si le Worker porte un autre nom dans Cloudflare, Workers Builds utilise le sien (simple avertissement).
  "name": "nexora",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // NEXORA #079 : garder les variables réglées dans le tableau de bord Cloudflare. Sans cette ligne, chaque
  // `wrangler deploy` (donc chaque envoi sur GitHub) remplace les variables en clair par celles de ce fichier
  // (aucune) : NX_LICENSE_SIGNING_KEY et NX_PROBE_SECRET disparaissaient. Les variables de type « Secret »
  // (chiffrées), recommandées pour ces clés, sont gardées dans tous les cas.
  "keep_vars": true,
  // Lancée par `wrangler deploy` avant l'envoi, même si aucune commande de build n'est réglée dans
  // Cloudflare : dist/ est toujours reconstruit à partir des sources du commit.
  "build": {
    "command": "pnpm run build",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Le script ne tourne que pour le relais ; toutes les autres adresses sont servies directement.
    // NEXORA #048 : signal de vie, repères de déploiement et visiteurs réels (worker/fiabilite.js).
    // NEXORA #076 : contrôle de licence signé et abonnements (worker/licences.js).
    "run_worker_first": ["/__supabase-api/*", "/hb/*", "/hook/*", "/rum", "/license/*", "/pay/*", "/security/*"],
    // NEXORA #096 : site vitrine à la racine, une page HTML pré-générée par adresse (tarifs.html sert /tarifs) ;
    // NEXORA web (/studio/), le back office (/admin/) et l'espace des parrains (/referral/) gardent leurs routes
    // après #. Une adresse inconnue reçoit la page 404 du site, avec le code 404 (jamais une page vide indexable).
    "not_found_handling": "404-page",
  },
  // NEXORA #048 : deuxième région de la supervision, chaque minute (sans effet tant que la variable
  // NX_PROBE_SECRET n'est pas réglée dans Cloudflare, voir supabase/migrations/20261105000008_fiabilite.sql).
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
